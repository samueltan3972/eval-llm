# Copy this file to `.env` and fill in your keys. promptfoo loads `.env` automatically
# from this directory, so you do NOT need to `export` anything manually.
#
#   cp .env.example .env      # then edit .env with your real keys
#
# `.env` is gitignored — never commit real keys.

# Required: Anthropic models (the two default providers run on this single key).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: uncomment the OpenAI provider in promptfooconfig.yaml to use this.
# OPENAI_API_KEY=sk-your-openai-key-here
